# Set one of the following keys to use a real LLM provider.
# If none are set, the backend runs in a Mock Fallback Mode.

# Google Gemini API Key
GEMINI_API_KEY=

# Groq API Key
GROQ_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# OpenRouter API Key
OPENROUTER_API_KEY=

# Backend proxy port (optional, defaults to 3001)
PORT=3001
